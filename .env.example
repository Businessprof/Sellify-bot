# ==========================================
# Telegram Bot Configuration
# ==========================================
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_USERNAME=Sellify_Bot

# ==========================================
# Mandatory Membership Channel & Group
# ==========================================
MANDATORY_CHANNEL_ID=-1001234567890
MANDATORY_CHANNEL_LINK=https://t.me/your_channel
MANDATORY_GROUP_ID=-1001987654321
MANDATORY_GROUP_LINK=https://t.me/your_group
LIVE_SALES_CHANNEL_ID=-1001122334455

# ==========================================
# Database Configuration
# Local SQLite default: sqlite+aiosqlite:///./sellify.db
# Production PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/sellify_bot
# ==========================================
DATABASE_URL=sqlite+aiosqlite:///./sellify.db
DB_ECHO=false

# ==========================================
# Redis Configuration (Optional for local dev)
# ==========================================
REDIS_URL=redis://localhost:6379/0

# ==========================================
# Application & Store Settings
# ==========================================
APP_NAME=Sellify
CURRENCY_SYMBOL=$
DEFAULT_REFERRAL_COMMISSION_PERCENT=10.0
SUPPORT_CHAT_ID=-1001234567890
ADMIN_TELEGRAM_IDS=[6186806738]

# ==========================================
# Security & Secret Keys
# ==========================================
SECRET_KEY=change_this_to_a_super_secure_random_secret_in_production
JWT_SECRET=change_this_to_a_jwt_secret_in_production
WEBHOOK_SECRET=telegram_webhook_secret_key
WEBHOOK_URL=https://yourdomain.com/api/v1/webhooks/telegram
